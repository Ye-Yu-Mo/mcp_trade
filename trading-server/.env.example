# Trading Server 环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env
# 不要把 .env 提交到 git。

# 运行模式: paper | testnet | mainnet (默认 testnet)
# paper = 主网真实行情 + 本地模拟成交，推荐先用这个验证策略
TRADE_ENV=paper

# Binance API 凭据（paper 模式仅用于访问公开行情；实盘/测试网必填）
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# HTTP 服务端口
SERVER_PORT=8877

# DuckDB 持久化路径
DB_PATH=data/trade.duckdb

# API 鉴权 Token（MCP Server 和 Frontend 调用时需带此 Token）
# 生成: openssl rand -hex 24
API_TOKEN=your_secret_token_here

# 行情源。始终使用主网真实行情，不要改成测试网。
MARKET_DATA_URL=https://fapi.binance.com

# 启动时是否修改账户设置（持仓模式/保证金/杠杆）。
# 默认 false：服务不会静默改动实盘账户。确认需要初始化时再设 true。
SETUP_ACCOUNT=false

# --- 纸面模式 ---
PAPER_BALANCE=33.12
PAPER_STATE_PATH=data/paper_state.json

# --- 风控（占权益比例，0.01 = 1%）---
RISK_PER_TRADE_PCT=0.01
MAX_TOTAL_RISK_PCT=0.03
MAX_POSITIONS=2
MAX_LEVERAGE=5
DAILY_LOSS_PCT=0.03
WEEKLY_LOSS_PCT=0.08
